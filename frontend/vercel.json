{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://lightnation-api.vercel.app/api/:path*"
    },
    {
      "source": "/reports/:path*",
      "destination": "https://lightnation-api.vercel.app/reports/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
